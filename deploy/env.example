# Copiar a /etc/server-status/env con modo 0600 y dueño server-status.
# ESTE ARCHIVO NO VA AL REPO CON VALORES REALES.

# API key de la app 'server-status' en comm-tool. Camino principal.
COMM_TOOL_API_KEY=

# Token del bot, de BotFather. Camino de respaldo directo — es el único por el
# que puede llegar el aviso de que comm-tool se cayó.
TELEGRAM_BOT_TOKEN=

# Chat id propio. Si ya le mandaste un /start al bot, sale de getUpdates.
TELEGRAM_CHAT_ID=
